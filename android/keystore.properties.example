# Copy this file to android/keystore.properties (already gitignored —
# never commit that file or the .keystore/.jks itself) and fill in your
# real release signing values.
#
# storeFile is resolved relative to android/app/, same as debug.keystore.
storeFile=release.keystore
storePassword=CHANGE_ME
keyAlias=mango-pro-release
keyPassword=CHANGE_ME
